# ==============================================================================
# Whispr Environment Variables Template
# Copy this file to .env and fill in your values
# ==============================================================================

# Backend Database (PostgreSQL)
# Local:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/whispr_dev
SPRING_DATASOURCE_USERNAME=whispr
SPRING_DATASOURCE_PASSWORD=password

# Cloud / Supabase Configuration (Render Environment Variable: DATABASE_URL):
# Option A (Recommended - Session Pooler Port 5432):
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# Option B (Transaction Pooler Port 6543):
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Security (JWT)
# Must be a secure random 256-bit (32+ bytes) string
JWT_SECRET=thisIsAVerySecretKeyForWhisprAppThatMustBeAtLeast32BytesLong

# CORS Configuration (Frontends allowed)
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://whispr-theta-smoky.vercel.app

# Stripe Monetization (Optional in dev / Required in prod)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Keep Alive Monitoring
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_URL=https://whispr-z6zx.onrender.com/api/health
